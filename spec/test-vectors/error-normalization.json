{
  "schema_version": "0.1.0",
  "rule": "wallet and library errors normalize to canonical OpenReceive error codes",
  "cases": [
    {
      "name": "send-side wallet code (insufficient balance) is OTHER on a receive-only client",
      "raw_error": {
        "error": {
          "code": "insufficient-balance",
          "message": "Wallet lacks spendable sats",
          "request_id": "req_balance"
        }
      },
      "expected": {
        "code": "OTHER",
        "message": "Wallet lacks spendable sats",
        "retryable": false,
        "request_id": "req_balance"
      }
    },
    {
      "name": "library timeout error name",
      "raw_error": {
        "name": "TimeoutError",
        "message": "Relay request timed out"
      },
      "expected": {
        "code": "TIMEOUT",
        "message": "Relay request timed out",
        "retryable": true
      }
    },
    {
      "name": "send-side wallet code (payment failed) is OTHER on a receive-only client",
      "raw_error": {
        "code": "PAYMENT_FAILED",
        "message": "Payment route failed"
      },
      "expected": {
        "code": "OTHER",
        "message": "Payment route failed",
        "retryable": false
      }
    },
    {
      "name": "network error name beats generic OTHER code",
      "raw_error": {
        "name": "Nip47NetworkError",
        "code": "OTHER",
        "message": "Failed to connect to relay"
      },
      "expected": {
        "code": "WALLET_UNAVAILABLE",
        "message": "Failed to connect to relay",
        "retryable": true
      }
    },
    {
      "name": "a wallet's own FORBIDDEN is a wallet restriction, never the host's FORBIDDEN",
      "raw_error": {
        "code": "FORBIDDEN",
        "message": "Method not permitted for this connection"
      },
      "expected": {
        "code": "RESTRICTED",
        "message": "Method not permitted for this connection",
        "retryable": false
      }
    }
  ]
}
