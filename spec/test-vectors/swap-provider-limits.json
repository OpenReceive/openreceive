{
  "schema_version": "0.1.0",
  "decision": "size_the_request_guard_by_provider",
  "rationale": "Every engine attaches a per-process request guard to a swap provider so a busy site stays inside the provider's API limits. The same wire contract is served at very different rates: FixedFloat allows 250 weight a minute per key with a create costing 50, and blocks a key for longer each time it goes over; Lightning Swap allows an account 30 new swaps and 400 calls a minute, answers 429 with the wait, and never blocks a key. The provider's HTTPS host picks the limits. An unknown host gets the FixedFloat limits because they are the stricter. The provider stays the authority: its 429 always starts a stand-off, for the wait it names when it names one.",
  "window_seconds": 60,
  "profiles": {
    "fixedfloat": {
      "soft_cap": 200,
      "create_gate": 150,
      "create_weight": 50,
      "default_weight": 1,
      "create_limit": null,
      "backoff_seconds": 60,
      "min_backoff_seconds": 60,
      "max_backoff_seconds": 3600,
      "create_backoff_only": false
    },
    "lightning-swap": {
      "soft_cap": 400,
      "create_gate": 400,
      "create_weight": 1,
      "default_weight": 1,
      "create_limit": 30,
      "backoff_seconds": 60,
      "min_backoff_seconds": 1,
      "max_backoff_seconds": 300,
      "create_backoff_only": true
    }
  },
  "hosts": [
    {
      "base_url": "https://lightning-swap.com",
      "profile": "lightning-swap"
    },
    {
      "base_url": "https://lightning-swap.com/",
      "profile": "lightning-swap"
    },
    {
      "base_url": "https://api.lightning-swap.com/v1",
      "profile": "lightning-swap"
    },
    {
      "base_url": "https://LIGHTNING-SWAP.com",
      "profile": "lightning-swap"
    },
    {
      "base_url": "https://lightning-swap.com:8443/api",
      "profile": "lightning-swap"
    },
    {
      "base_url": "https://ff.io",
      "profile": "fixedfloat"
    },
    {
      "base_url": "https://swap.example/v1",
      "profile": "fixedfloat"
    },
    {
      "base_url": "https://evil-lightning-swap.com",
      "profile": "fixedfloat",
      "note": "A look-alike host is not Lightning Swap."
    },
    {
      "base_url": "https://lightning-swap.com.example",
