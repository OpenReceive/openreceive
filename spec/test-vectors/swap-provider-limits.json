      "note": "A look-alike host is not Lightning Swap."
    },
    {
      "base_url": "not a url",
      "profile": "fixedfloat"
    }
  ],
  "steps_note": "A scenario builds one guard for `profile` with its clock at the first step's `at`, then runs the steps in order with the clock set to each step's `at`. `reserve` uses budget; `check` asks whether a reserve would be allowed and uses none; `rate_limited` tells the guard the provider answered 429 on `path` (`retry_after` is the provider's wait in seconds, absent when it named none). `repeat` runs the step that many times. `expect` is `ok`, `exhausted` or `backoff`; `backoff_until` is the unix second the stand-off ends, as the denial reports it.",
  "scenarios": [
    {
      "name": "FixedFloat: three creates a minute, then the window rolls",
      "profile": "fixedfloat",
      "steps": [
        {
          "at": 1000,
          "op": "reserve",
          "path": "create",
          "repeat": 3,
          "expect": "ok"
        },
        {
          "at": 1000,
          "op": "reserve",
          "path": "create",
          "expect": "exhausted"
        },
        {
          "at": 1000,
          "op": "reserve",
          "path": "order",
          "repeat": 50,
          "expect": "ok"
        },
        {
          "at": 1000,
          "op": "reserve",
          "path": "order",
          "expect": "exhausted",
          "note": "150 + 50 = the 200 soft cap."
        },
        {
          "at": 1059,
          "op": "reserve",
          "path": "create",
          "expect": "exhausted"
        },
        {
          "at": 1060,
          "op": "reserve",
          "path": "create",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "a check uses no budget",
      "profile": "fixedfloat",
      "steps": [
        {
          "at": 1000,
          "op": "check",
          "path": "create",
          "repeat": 10,
          "expect": "ok"
        },
        {
          "at": 1000,
          "op": "reserve",
          "path": "create",
          "repeat": 3,
          "expect": "ok"
        },
        {
          "at": 1000,
          "op": "check",
          "path": "create",
          "expect": "exhausted"
        },
        {
          "at": 1000,
          "op": "check",
          "path": "order",
          "expect": "ok"
        }
      ]
    },
    {
