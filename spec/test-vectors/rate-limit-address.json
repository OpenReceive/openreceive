{
  "schema_version": "0.1.0",
  "decision": "never_count_a_non_payer_address",
  "rationale": "The opt-in per-IP limit counts one client address as one payer. A server sees a loopback, private, carrier-shared or link-local address only when the request came from its own proxy or network, so that address stands for every payer at once: counting it would stop the whole site at the limit. Such an address is never counted (the request is allowed, with one warning). Every other IP is counted, and so is a value that is not an IP at all, because a host that passes its own identifier chose it deliberately.",
  "applies_to": "The value after the engine's own normalization (trim, lower-case, IPv4-mapped IPv6 collapsed) or after /64 bucketing; both forms must classify the same.",
  "cases": [
    {
      "name": "'203.0.113.9' is a payer",
      "address": "203.0.113.9",
      "expected": {
        "payer": true
      }
    },
    {
