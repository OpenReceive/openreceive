{
  "description": "Secret-safe diagnostic strings and nested fields. All credential markers are intentionally invalid fixtures. Public errors additionally omit raw causes, stacks and configuration.",
  "vectors": [
    {
      "name": "supported-uri-forms",
      "input": "nostr+walletconnect://invalid-fixture?secret=not-a-credential lightning+swapconnect:invalid-fixture?key=invalid-key&secret=invalid-secret NOSTR+WALLETCONNECT:invalid-fixture?secret=invalid-secret",
      "expected": "[REDACTED_NWC] [REDACTED_LSC] [REDACTED_NWC]"
    },
    {
      "name": "embedded-query-credentials",
      "input": "https://example.invalid/status?key=invalid-key&token=invalid-token&secret=invalid-secret&provider_token=invalid-token&api_key=invalid-key&choice=1",
      "expected": "https://example.invalid/status?key=[REDACTED]&token=[REDACTED]&secret=[REDACTED]&provider_token=[REDACTED]&api_key=[REDACTED]&choice=1"
    },
    {
      "name": "nested-sensitive-fields",
      "input": {
        "method": "POST",
        "status": 502,
        "order_id": "fixture-order",
        "duration_ms": 12,
        "token_present": true,
        "details": [
          {
            "provider_token": "invalid-token",
            "apiKey": "invalid-key",
            "swap_data": {
              "token": "invalid-token"
            },
            "invoice": "invalid-invoice",
            "preimage": "invalid-preimage",
            "message": "via lightning+swapconnect://invalid-fixture?secret=invalid-secret"
          }
        ]
      },
      "expected": {
        "method": "POST",
        "status": 502,
        "order_id": "fixture-order",
        "duration_ms": 12,
        "token_present": true,
        "details": [
          {
            "provider_token": "[REDACTED]",
            "apiKey": "[REDACTED]",
            "swap_data": "[REDACTED]",
            "invoice": "[REDACTED]",
            "preimage": "[REDACTED]",
            "message": "via [REDACTED_LSC]"
          }
        ]
      }
    }
  ]
}
