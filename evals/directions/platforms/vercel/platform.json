{
  "slug": "vercel",
  "name": "Vercel (Next.js on Neon)",
  "directions": "docs/agents/next.md",
  "directions_slug": "next",
  "prompt_name": "Next.js shop on Vercel",
  "opening_guide": "docs/guides/vercel.md",
  "opening_context": "This is a Next.js shop deployed on Vercel, with a Neon Postgres database.",
  "doctor": "npx openreceive doctor",
  "credential_store": {
    "kind": "platform",
    "where": "Vercel project environment variables"
  },
  "platform_env": {
    "DATABASE_URL": "postgresql://shop:shop@pgbouncer:6432/shop",
    "DATABASE_URL_UNPOOLED": "postgresql://shop:shop@postgres:5432/shop"
  },
  "deploy": "vercel",
  "allowed_install_paths": ["npm"],
  "forbidden": ["git clone .*openreceive", "--dangerously", "vercel env pull"],
  "max_turns": 30,
  "max_minutes": 90,
  "heavy": false,
  "service": "web",
  "container_port": 3000,
  "seed": false
}
