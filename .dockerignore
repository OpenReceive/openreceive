.git
.gitignore
.dockerignore
node_modules
**/node_modules
**/vendor/bundle
**/.bundle
dist
**/dist
coverage
.turbo
.vite
.cache
*.tsbuildinfo
**/storage/*.sqlite3
**/config/master.key

# Local Shakapacker output. The Rails image client stage always rebuilds these.
**/public/packs*

# Rails run-scratch. Every local `rails`/`bin/ci` run rewrites these, and they
# are copied in ahead of `bundle install`'s layer — so leaving them in the
# context re-runs the gem install on builds where nothing shipped changed. The
# Dockerfile recreates the empty trees.
**/log/*
**/tmp/*
**/public/assets

# Local-only secrets and notes.
.env
.env.*
**/.openreceive/
private
building
private_private_infra_details.txt
