{
  "name": "openreceive-workspace",
  "version": "0.3.0",
  "private": true,
  "description": "OpenReceive receive-checkout reference path",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/js/*",
    "examples/hello-fruit/server/node-express",
    "examples/hello-fruit/server/static-html-small-api",
    "examples/hello-fruit/server/nextjs-fullstack",
    "examples/hello-fruit/server/rails"
  ],
  "scripts": {
    "generate:agent-directions": "node tools/docs/generate-agent-directions.mjs",
    "generate:site-contract": "node tools/docs/generate-site-contract.mjs",
    "build:docs": "npm run generate:agent-directions && npm run generate:site-contract && node tools/docs/build-index.mjs",
    "check:docs": "node tools/docs/generate-agent-directions.mjs --check && node tools/docs/generate-site-contract.mjs --check && node tools/docs/build-index.mjs",
    "build:demo": "npm run build -w @openreceive/example-node-express && npm run build -w @openreceive/example-static-html-small-api && npm run build -w @openreceive/example-nextjs-fullstack && npm run build -w @openreceive/example-rails",
    "demo": "node --import tsx tools/run-demo.mjs",
    "generate:models": "node tools/codegen/generate-js-models.mjs",
    "check:generated": "node tools/codegen/generate-js-models.mjs --check",
    "check:demo-containers": "node tools/validate/check-demo-containers.mjs",
    "check:release": "node tools/validate/check-release-readiness.mjs",
    "check:workflows": "node tools/validate/check-workflows.mjs",
    "check:public-api": "node tools/validate/check-public-api.mjs",
    "check:dead-exports": "knip",
    "build:packages": "npm run build -w @openreceive/core -w @openreceive/provider-data -w @openreceive/browser -w @openreceive/elements -w @openreceive/node -w @openreceive/http -w @openreceive/express -w @openreceive/fastify -w @openreceive/next -w @openreceive/react -w @openreceive/vue -w @openreceive/svelte -w @openreceive/angular -w @openreceive/testkit",
    "release:plan": "node tools/release/npm-release.mjs plan",
    "release:prepare": "node tools/release/npm-release.mjs prepare",
    "release:stamp": "node tools/release/npm-release.mjs stamp",
    "release:publish": "node tools/release/npm-release.mjs publish",
    "release:gem:plan": "node tools/release/gem-release.mjs plan",
    "release:gem:build": "node tools/release/gem-release.mjs build",
    "release:gem:publish": "node tools/release/gem-release.mjs publish",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "scan:client-bundles": "node tools/validate/scan-client-bundles.mjs",
    "test:package-smoke": "node tools/validate/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "pretest:js": "npm run build -w @openreceive/core -w @openreceive/provider-data -w @openreceive/browser -w @openreceive/elements -w @openreceive/angular",
    "test:js": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test --config tests/e2e",
    "test:orms": "prisma generate --schema tests/orms/schema.prisma && node --import tsx --test tests/orms/*.test.mjs",
    "test:e2e:smoke": "playwright test --config tests/e2e lightning.spec.ts --grep @smoke",
    "test:ruby": "bash tools/ci/ruby-tests.sh",
    "test:live:ruby:nwc": "ruby -Ipackages/ruby/openreceive/lib tools/live-nwc-test/ruby-smoke.rb",
    "validate": "node tools/validate/validate-spec.mjs",
    "scan:secrets": "node tools/validate/scan-secrets.mjs",
    "check": "npm run validate && npm run scan:secrets",
    "test": "npm run test:js",
    "test:ci:core": "npm run check && npm run lint && npm run format:check && npm run check:workflows && npm run check:generated && npm run check:docs && npm run check:public-api && npm run typecheck && npm run check:vue && npm run check:svelte && npm run check:dead-exports && npm test && npm run test:package-smoke",
    "test:ci:release": "npm run build:packages && npm run test:ruby && npm run check:demo-containers && npm run check:release && npm run test -w @openreceive/example-rails && npm run build:demo && npm run scan:client-bundles && npm run build:docs",
    "test:ci": "npm run test:ci:core && npm run test:ci:release",
    "test:live": "npm run test:live:nwc && npm run test:live:ruby:nwc",
    "test:live:nwc": "node tools/live-nwc-test/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@angular/common": "22.0.3",
    "@angular/compiler": "22.0.3",
    "@angular/core": "22.0.3",
    "@angular/platform-browser": "22.0.3"
  },
  "devDependencies": {
    "@angular/compiler": "22.0.3",
    "@angular/compiler-cli": "^22.0.3",
    "@angular/core": "22.0.3",
    "@biomejs/biome": "^2.5.1",
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "1.62.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "happy-dom": "^20.11.2",
    "knex": "^3.3.0",
    "knip": "^6.32.2",
    "ng-packagr": "^22.1.1",
    "prisma": "^7.9.1",
    "svelte-check": "4.7.6",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typeorm": "^1.1.0",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.11",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "@prisma/client@7.9.1": true
  }
}
