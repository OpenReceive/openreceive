# Server-only credentials. Copy this file to .env and replace the placeholders.
# Never expose any complete value to browser code or commit the resulting .env.
NWC_URI=nostr+walletconnect://WALLET_SERVICE_PUBLIC_KEY?relay=wss%3A%2F%2Frelay.example&secret=CLIENT_SECRET
LSC_URI_PRIMARY=lightning+swapconnect://primary.example/?key=PROVIDER_KEY&secret=PROVIDER_SECRET
LSC_URI_BACKUP=

# Non-secret console/file log verbosity for server and browser demos.
# DEBUG | INFO | WARN | ERROR (case-insensitive). Default INFO.
LOG_LEVEL=INFO

# WARNING: OpenReceive refuses to boot when the NWC code advertises spend
# methods such as pay_invoice, because a leaked spend-capable code can drain
# the wallet. Uncomment and set true only if the wallet cannot mint a
# receive-only code and you accept that risk.
# OPENRECEIVE_ALLOW_SPEND_CAPABLE_NWC=false

# Optional dev/test overrides for the BTC/fiat price feeds (must serve
# Simple Price JSON). Leave commented for the live defaults.
# OPENRECEIVE_PRICE_FEED_PRIMARY_URL=
# OPENRECEIVE_PRICE_FEED_FALLBACK_URL=
