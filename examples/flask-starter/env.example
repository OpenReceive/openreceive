# Copy to .env. Compose loads it into the server's environment.

# A receive-only NWC code: https://openreceive.org/get_a_nwc_code_to_receive_payments
NWC_URI=

# Optional swap provider codes, for USDT, USDC, SOL and ETH:
# https://openreceive.org/set_up_swap_provider
LSC_URI_PRIMARY=
LSC_URI_BACKUP=

# Signs the session cookie that says which browser owns an order. Set a long
# random value in production; without one, every restart forgets the sessions.
SECRET_KEY=

# Optional. SQLite in the data volume when unset; for Postgres, add
# psycopg[binary] to requirements.txt and use postgresql+psycopg://...
DATABASE_URL=
