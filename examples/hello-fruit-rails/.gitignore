# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/vendor/bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/config/*.key
/.env*
!/.env.example
/db/*.sqlite3
/db/*.sqlite3-*
