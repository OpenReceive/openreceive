<main class="min-h-screen grid justify-items-center content-start p-4 md:p-8 gap-4">
  <section class="w-full max-w-xl grid gap-4" data-controller="checkout">
    <header class="grid gap-1">
      <h1 class="text-2xl font-bold">OpenReceive Rails quickstart</h1>
      <p class="text-base-content/70 text-sm">
        Minimal host Order + openreceive_payments. Create a $2.00 USD order, then pay with Lightning.
      </p>
    </header>

    <button type="button" class="btn btn-primary" data-action="checkout#createOrder" data-checkout-target="createButton">
      Create $2.00 order
    </button>

    <div class="hidden grid gap-3" data-checkout-target="payPanel">
      <p class="text-sm" data-checkout-target="orderStatus"></p>
      <label class="form-control w-full">
        <span class="label-text text-sm">BOLT11 invoice</span>
        <textarea class="textarea textarea-bordered font-mono text-xs" rows="4" readonly data-checkout-target="invoice"></textarea>
      </label>
      <p class="text-sm text-base-content/70" data-checkout-target="pollStatus">Waiting for payment…</p>
    </div>

    <p class="alert alert-error hidden" role="status" data-checkout-target="error"></p>
  </section>
</main>
