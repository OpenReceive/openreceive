# Copy to .env.local for local development. On Vercel, set these in the
# project's Environment Variables; the Neon integration adds the database
# variables for you.

# A receive-only NWC code: https://openreceive.org/get_a_nwc_code_to_receive_payments
NWC_URI=

# Optional swap provider codes, for USDT, USDC, SOL and ETH:
# https://openreceive.org/set_up_swap_provider
LSC_URI_PRIMARY=
LSC_URI_BACKUP=

# Pooled Postgres URL (Neon's DATABASE_URL).
DATABASE_URL=
# Direct URL for migrations (Neon's DATABASE_URL_UNPOOLED). Optional;
# migrations fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
