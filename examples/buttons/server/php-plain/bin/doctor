#!/usr/bin/env php
<?php

/**
 * Step 0 of the agent directions for a plain-PHP host, as one command: every
 * credential as set/unset (never a value), the host class and which hooks are
 * still placeholders, the mount, and the receive-only wallet preflight.
 *
 * A framework has a place to hang this (bin/rails openreceive:doctor, php
 * artisan openreceive:doctor); a plain host is this script — a dozen lines
 * around OpenReceive\Server\Doctor::report(). Copy it.
 */

declare(strict_types=1);

use OpenReceive\Server\Doctor;
use OpenReceive\Server\Service;

require dirname(__DIR__) . '/vendor/autoload.php';

$env = Service::processEnvironment();
// The demo's host lives inline in public/index.php, so the doctor reports the
// hooks as set from that file's presence; a host class of your own goes here.
$host = null;
$mounted = '/openreceive';
$walletCheck = ($env['DEMO_WALLET'] ?? '') === 'testkit'
    ? static function (): void { /* the fakes need no wallet */ }
    : static function () use ($env): void { Service::fromEnvironment($env); };

foreach (Doctor::report($env, $host, $walletCheck, $mounted) as $line) {
    echo $line, PHP_EOL;
}
echo '  host:             the three hooks are the anonymous class in public/index.php', PHP_EOL;
