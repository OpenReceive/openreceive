# frozen_string_literal: true

source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "propshaft"
# Webpack-driven frontend (React + Mantine + mobx-keystone). Version pinned to
# match the npm shakapacker package exactly (ensure_consistent_versioning).
gem "shakapacker", "9.7.0"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"
# Database-backed ActionCable, no Redis. The `notifications` worker container
# settles orders in its OWN process; solid_cable is how its broadcast reaches
# the websockets Puma is holding, through the database they already share.
gem "solid_cable"
# Per-IP cap on the public recent-orders feed. See
# config/initializers/rack_attack.rb; the engine's own routes are capped
# separately by config.rate_limiting.
gem "rack-attack"
gem "tzinfo-data", platforms: %i[windows jruby]

# Path gems from this monorepo (Dockerfile copies packages/ruby into the image).
gem "openreceive", path: "../../../../packages/ruby/openreceive"
gem "openreceive-server", path: "../../../../packages/ruby/openreceive-server"
gem "openreceive-rails", path: "../../../../packages/ruby/openreceive-rails"
gem "nwc-ruby"
gem "dotenv-rails", groups: %i[development test]

group :development, :test do
  # bin/bundler-audit (run by bin/ci) needs the gem inside the app bundle.
  gem "bundler-audit", require: false
end

group :development do
  gem "web-console"
end
