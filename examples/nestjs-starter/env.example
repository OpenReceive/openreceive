# Copy to .env. Never commit it.

# A receive-only NWC code: https://openreceive.org/get_a_nwc_code_to_receive_payments
NWC_URI=

# Optional swap provider codes, for USDT, USDC, SOL and ETH:
# https://openreceive.org/set_up_swap_provider
LSC_URI_PRIMARY=
LSC_URI_BACKUP=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Postgres connection URL. compose.yml sets its own for the bundled database.
DATABASE_URL=
