modules = ["nodejs-22", "postgresql-16"]
run = "npm install && npm start"

# Autoscale: payments settle during requests, so the app needs no process that
# stays up between them.
[deployment]
deploymentTarget = "autoscale"
build = ["npm", "install"]
run = ["npm", "start"]

[[ports]]
localPort = 5000
externalPort = 80

# Run and Preview need a workflow: without one, Replit reports the shop as
# crashed even while it listens on port 5000.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
