# Copy to .env for local development. On Replit, add these in the Secrets
# tool instead, and again under Publishing for the published app; Replit sets
# DATABASE_URL for you.

# A receive-only NWC code: https://openreceive.org/get_a_nwc_code_to_receive_payments
NWC_URI=

# Optional swap provider codes, for USDT, USDC, SOL and ETH:
# https://openreceive.org/set_up_swap_provider
LSC_URI_PRIMARY=
LSC_URI_BACKUP=

# Postgres connection URL.
DATABASE_URL=
