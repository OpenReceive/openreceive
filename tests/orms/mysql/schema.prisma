// The MySQL and MariaDB client for test:orms. As in ../schema.prisma, the
// tests drive the payments repository through raw queries; the model only
// keeps `prisma generate` happy.
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

model OpenreceiveMeta {
  key   String @id
  value String
  rev   Int

  @@map("openreceive_meta")
}
