// The PostgreSQL client for the pooler lane in test:orms. As in
// ../schema.prisma, the tests drive the payments repository through raw
// queries; the model only keeps `prisma generate` happy.
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model OpenreceiveMeta {
  key   String @id
  value String
  rev   Int

  @@map("openreceive_meta")
}
