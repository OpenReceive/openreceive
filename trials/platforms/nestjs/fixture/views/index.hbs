<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Widget Shop</title>
</head>
<body>
<main>
<h1>Widget Shop</h1>
<ul>
{{#each products}}
  <li>
    {{name}} — ${{price}}
    <form method="post" action="/orders">
      <input type="hidden" name="product_id" value="{{id}}">
      <button type="submit">Buy</button>
    </form>
  </li>
{{/each}}
</ul>
</main>
</body>
</html>
