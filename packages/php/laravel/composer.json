{
  "name": "openreceive/laravel",
  "description": "OpenReceive for Laravel: the service provider, routes, install command and artisan workers over the openreceive/openreceive engine — receive-only Lightning (NWC) checkout inside your own Laravel application and database.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://openreceive.org",
  "support": {
    "issues": "https://github.com/OpenReceive/openreceive/issues",
    "source": "https://github.com/OpenReceive/openreceive"
  },
  "keywords": [
    "laravel",
    "lightning",
    "nwc",
    "nostr",
    "payments",
    "bitcoin",
    "checkout"
  ],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^11.0 || ^12.0",
    "illuminate/contracts": "^11.0 || ^12.0",
    "illuminate/database": "^11.0 || ^12.0",
    "illuminate/http": "^11.0 || ^12.0",
    "illuminate/routing": "^11.0 || ^12.0",
    "illuminate/support": "^11.0 || ^12.0",
    "nyholm/psr7": "^1.8",
    "openreceive/openreceive": "~0.4.4",
    "symfony/psr-http-message-bridge": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "OpenReceive\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenReceive\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "OpenReceive\\Laravel\\OpenReceiveServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../openreceive",
      "options": {
        "symlink": true,
        "versions": {
          "openreceive/openreceive": "0.4.4"
        }
      }
    }
  ],
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "platform-check": true,
    "platform": {
      "php": "8.2.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
