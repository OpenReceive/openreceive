<?php

declare(strict_types=1);

namespace {{ namespace }};

use OpenReceive\Host as OpenReceiveHost;
use OpenReceive\Hosts\AllowAllAuthorize;
use OpenReceive\Hosts\LoggingOnPaid;
use OpenReceive\PaymentSettlement;
use OpenReceive\Server\AuthorizeContext;

/**
 * Generated by `php artisan openreceive:install`. THE THREE METHODS BELOW ARE
 * THE ONLY BRIDGE between OpenReceive and this application's data. OpenReceive
 * never sees your Order model, your users or your prices; it asks this class.
 *
 * `Order` in the examples is YOUR model — it could be named anything.
 *
 * Two of the three are still the generated PLACEHOLDERS (the two traits), and
 * the engine warns every time the application boots until both are replaced:
 * `AllowAllAuthorize` lets anyone holding an order id mint invoices, poll and
 * request refunds for it; `LoggingOnPaid` records the order as settled without
 * fulfilling anything.
 */
final class Host implements OpenReceiveHost
{
    // THE HOST AUTHORIZES EVERY REQUEST; OpenReceive mints no tokens.
    //
    // Runs before every checkout/payment/swap route. `$context` carries:
    //   $context->action    — "checkout.prepare", "checkout.create",
    //                         "payment.check", "swap.quote", "swap.create",
    //                         "swap.read" or "swap.refund"
    //   $context->request   — the Illuminate\Http\Request: read the session,
    //                         cookies or headers from it, as in a controller
    //   $context->resource  — ['reference' => …, 'payment_hash' => ?] copied
    //                         from the payer's JSON body. It NAMES an order; it
    //                         does not prove this caller owns it. reference is a
    //                         validated non-empty string (≤200 chars); payment_hash
    //                         is null except on payment.check / swap.read / swap.refund.
    // Return true to allow, false for a 403.
    //
    // The trait below is the allow-all placeholder. Replace it with this app's
    // real ownership check — the same one your order page already makes:
    //
    //   public function authorize(AuthorizeContext $context): bool
    //   {
    //       $order = Order::find($context->reference());
    //       return $order !== null && $order->user_id === $context->request->user()?->id;
    //   }
    use AllowAllAuthorize;

    // The trait below is the logging-only placeholder for onPaid. Replace it
    // with your fulfillment — see the note above onPaid's example below.
    use LoggingOnPaid;

    /**
     * The price for a reference — the string your checkout passes, typically
     * your order id — read from YOUR OWN ROW. Payer input never carries an
     * amount. Return ['currency' => 'USD', 'value' => '12.00'] or
     * ['sats' => 1200], or null when there is nothing to pay for (a 404).
     *
     * `value` is a decimal STRING, never a float. An optional 'description'
     * beside the price is what the payer is BUYING, in your own words — the
     * one line the checkout renders above the amount.
     *
     * TODO(price): look the reference up in your own application, e.g.
     *
     *   $order = Order::find($reference);
     *   return $order === null ? null : [
     *       'currency' => 'USD',
     *       'value' => $order->total,               // a decimal string column
     *       'description' => $order->items->count() . ' items',
     *   ];
     *
     * @return array<string, mixed>|null
     */
    public function amountFor(string $reference): ?array
    {
        return null;
    }

    /*
     * Runs INSIDE the settlement transaction, only for the order's first
     * settled attempt. `$settlement` exposes reference, paymentHash, paidAt
     * (unix seconds) and details.
     *
{{ fulfillment_note }}
     *
     * TODO(fulfillment): replace the LoggingOnPaid trait above with your real
     * fulfillment, written as the guarded transition — a query-builder UPDATE
     * fires no model events, so the claim is one atomic conditional write:
     *
     *   public function onPaid(PaymentSettlement $settlement): void
     *   {
     *       $claimed = Order::where('id', $settlement->reference)
     *           ->where('state', 'awaiting_payment')
     *           ->update(['state' => 'paid', 'paid_at' => Carbon::createFromTimestampUTC($settlement->paidAt)]);
     *       if ($claimed === 0) {
     *           return; // someone else already fulfilled it
     *       }
     *       // FulfillOrder — like Order — is your own application code: ship the
     *       // goods, enqueue the confirmation email. OpenReceive provides neither.
     *       FulfillOrder::dispatchAfterResponse(Order::find($settlement->reference), $settlement->paymentHash);
     *   }
     *
     * If your transition has to go through the model (events, observers), take
     * a row lock for the duration instead:
     *
     *       $order = Order::lockForUpdate()->find($settlement->reference);   // SELECT … FOR UPDATE
     *       if ($order === null || $order->state !== 'awaiting_payment') return;
     *       $order->update(['state' => 'paid', 'paid_at' => …]);              // events fire
     *
     * Either way: DATABASE WRITES ONLY in here. An email or webhook sent from
     * this method survives a rollback. Implement OpenReceive\Hosts\AfterPaid
     * (`afterPaid(PaymentSettlement $settlement)`) for the after-COMMIT side
     * effects — an event dispatch, a queued mail.
     */
}
