{
    "name": "openreceive/openreceive",
    "description": "OpenReceive engine for PHP: receive-only Lightning (NWC) checkout, exact money, settlement reconciliation, swaps and a PSR-15 mount over the host's own database.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://openreceive.org",
    "support": {
        "issues": "https://github.com/OpenReceive/openreceive/issues",
        "source": "https://github.com/OpenReceive/openreceive"
    },
    "keywords": ["lightning", "nwc", "nostr", "payments", "bitcoin", "checkout"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17 || ^0.18 || ^0.19 || ^0.20",
        "dsbaars/nostr-php-nwc": "^0.0.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-gmp": "Fast elliptic-curve math for NIP-47 request signing (required by the bundled nostr-php transport).",
        "ext-sodium": "NIP-44 (ChaCha20) encryption without the pure-PHP polyfill.",
        "ext-pdo_pgsql": "PostgreSQL storage for openreceive_payments.",
        "ext-pdo_mysql": "MySQL/MariaDB storage for openreceive_payments.",
        "ext-pdo_sqlite": "SQLite storage for openreceive_payments."
    },
    "autoload": {
        "psr-4": {
            "OpenReceive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenReceive\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "platform-check": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
