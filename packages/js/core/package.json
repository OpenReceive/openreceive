{
  "name": "@openreceive/core",
  "version": "0.2.4",
  "description": "Shared OpenReceive primitives: NWC parsing, settlement rules, money math, rates, and error normalization.",
  "keywords": [
    "bitcoin",
    "lightning",
    "payments",
    "nwc",
    "bolt11",
    "openreceive"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./swap-address": {
      "types": "./dist/swap-address.d.ts",
      "import": "./dist/swap-address.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/contracts.ts src/swap-address.ts --format esm --dts --clean --target es2022 --out-dir dist",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "OpenReceive <info@openreceive.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreceive/openreceive.git",
    "directory": "packages/js/core"
  },
  "bugs": {
    "url": "https://github.com/openreceive/openreceive/issues"
  },
  "homepage": "https://openreceive.org",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
