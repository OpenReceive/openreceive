{
  "name": "@openreceive/vue",
  "version": "0.4.33",
  "description": "Vue component for Bitcoin Lightning checkout and optional USDT, USDC, SOL and ETH swaps.",
  "keywords": [
    "bitcoin",
    "lightning",
    "payments",
    "nwc",
    "bolt11",
    "openreceive",
    "vue",
    "checkout",
    "stablecoin",
    "usdt",
    "usdc",
    "payment-gateway",
    "self-hosted",
    "bitcoin-payments"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@openreceive/browser": "0.4.33",
    "@openreceive/elements": "0.4.33"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checkout.vue": {
      "types": "./dist/Checkout.vue.d.ts",
      "default": "./dist/Checkout.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --out-dir dist && node ../../../tools/package/compile-vue-sfc.mjs src/Checkout.vue dist/Checkout.js && node ../../../tools/package/copy-static.mjs src dist styles.css Checkout.vue.d.ts",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "author": "OpenReceive <info@openreceive.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreceive/openreceive.git",
    "directory": "packages/js/vue"
  },
  "bugs": {
    "url": "https://github.com/openreceive/openreceive/issues"
  },
  "homepage": "https://openreceive.org",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
