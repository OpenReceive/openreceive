@using BTCPayServer.Plugins.OpenReceive.Settings
@model BTCPayServer.Models.StoreViewModels.StoreDashboardViewModel
@inject OpenReceiveSettingsService OpenReceiveSettings
@{
    var store = Context.GetStoreData();
    var connected = store is not null && OpenReceiveSettings.GetConnection(store) is not null;
}
@if (store is not null && !connected)
{
    <a asp-controller="UIOpenReceive" asp-action="Setup" asp-route-storeId="@Model.StoreId" id="SetupGuide-OpenReceive" class="list-group-item list-group-item-action d-flex align-items-center">
        <vc:icon symbol="wallet-new" />
        <div class="content">
            <h5 class="mb-0">Receive to your own wallet with a receive-only NWC code</h5>
            <p class="mb-0 text-muted small">OpenReceive: Lightning into your wallet, optional USDT/USDC/ETH/SOL swaps.</p>
        </div>
        <vc:icon symbol="caret-right" />
    </a>
}
