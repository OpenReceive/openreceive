@using BTCPayServer.Plugins.OpenReceive.Swaps
@using BTCPayServer.Services.Invoices
@using BTCPayServer.Services.Stores
@model BTCPayServer.Models.InvoicingModels.CheckoutModel
@inject SwapService SwapService
@inject BtcPayInvoiceSource InvoiceSource
@{
    var availability = await CheckoutAvailability.ForRequestAsync(Context, Model.InvoiceId, InvoiceSource, SwapService);
}
@if (availability is { Offered: true })
{
    @* BTCPay's own pills get the ₿ mark through a rule the checkout script puts in <head> (see openreceive_swap_checkout.js). *@
    foreach (var offer in availability.Assets)
    {
        var pmId = "OpenReceiveSwap_" + offer.PayInAsset;
        var icon = offer.PayInAsset.Split('_')[0].ToLowerInvariant();
        if (offer.Available)
        {
            <a href="#@pmId" class="btcpay-pill m-0 payment-method openreceive-pill" :class="{ active: pmId === '@pmId' }" v-on:click.prevent="changePaymentMethod('@pmId')" title="Pay with @offer.AssetLabel on @offer.NetworkLabel">
                <img src="~/Resources/img/@(icon).svg" alt="" style="width:16px;height:16px;margin-right:.35rem;vertical-align:-3px" />@offer.AssetLabel · @offer.NetworkLabel
            </a>
        }
        else
        {
            <span class="btcpay-pill m-0 payment-method openreceive-pill" style="opacity:.5;cursor:not-allowed" title="@offer.Message@(offer.Limit is null ? "" : $" {offer.Limit}.")">
                <img src="~/Resources/img/@(icon).svg" alt="" style="width:16px;height:16px;margin-right:.35rem;vertical-align:-3px" />@offer.AssetLabel · @offer.NetworkLabel
            </span>
        }
    }
    var unavailable = availability.Assets.Where(a => !a.Available).ToList();
    if (unavailable.Count > 0)
    {
        @* Why the greyed pills are greyed, in words a shopper can act on (the JS checkout's "your cart total must be at least $2.43"). *@
        <div class="w-100 small text-muted text-center mt-1">
            @{
                var tooSmall = unavailable.Where(a => a.Reason == "amount_too_small").OrderBy(a => a.Limit?.Amount ?? decimal.MaxValue).ToList();
                var tooLarge = unavailable.Where(a => a.Reason == "amount_too_large").OrderByDescending(a => a.Limit?.Amount ?? 0).ToList();
                var others = unavailable.Where(a => a.Reason is not ("amount_too_small" or "amount_too_large")).GroupBy(a => a.Message ?? "Temporarily unavailable").ToList();
                // One line, lowest bar first, the unit once at the end when every bound shares it (the invoice currency).
                string Bounds(IEnumerable<SwapAssetOffer> offers)
                {
                    var list = offers.ToList();
                    var units = list.Select(a => a.Limit?.Unit).Where(u => u is not null).Distinct().ToList();
                    var shared = units.Count == 1 ? units[0] : null;
                    var items = list.Select(a => a.Limit is null ? $"{a.AssetLabel} · {a.NetworkLabel}" : $"{a.AssetLabel} · {a.NetworkLabel} {a.Limit.AmountText}{(shared is null ? " " + a.Limit.Unit : "")}");
                    return string.Join(", ", items) + (shared is null ? "" : " " + shared);
                }
            }
            @if (tooSmall.Count > 0)
            {
                <div>Minimum for this invoice: @Bounds(tooSmall)</div>
            }
            @if (tooLarge.Count > 0)
            {
                <div>Maximum for this invoice: @Bounds(tooLarge)</div>
            }
            @foreach (var group in others)
            {
                <div>@group.Key.TrimEnd('.'): @string.Join(", ", group.Select(a => $"{a.AssetLabel} · {a.NetworkLabel}"))</div>
            }
        </div>
    }
}
