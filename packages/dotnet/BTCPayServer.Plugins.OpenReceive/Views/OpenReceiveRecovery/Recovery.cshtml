@model string
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Payment status and refunds</title>
<style>[hidden]{display:none!important}body{font:16px system-ui;max-width:48rem;margin:3rem auto;padding:0 1rem;color:#222}article{border:1px solid #ccc;border-radius:.6rem;padding:1.2rem;margin:1rem 0}input{display:block;width:95%;padding:.7rem;margin:.6rem 0}button{padding:.6rem 1rem;cursor:pointer}small{overflow-wrap:anywhere}p{line-height:1.5}.error{color:#a22}</style></head>
<body><h1>Payment status and refunds</h1><p>Bookmark this page to return to each payment attempt, including older or expired instructions. Do not send another deposit to an expired or replaced address.</p>
<p id="error" class="error" role="alert"></p><main id="attempts"></main><button id="more" hidden>More attempts</button>
<script src="~/Resources/js/openreceive_recovery.js" asp-append-version="true"></script>
<script>OpenReceiveRecovery.start(@Safe.Json(Url.Content("~/api/plugins/openreceive/swaps/" + Model)));</script>
</body></html>
