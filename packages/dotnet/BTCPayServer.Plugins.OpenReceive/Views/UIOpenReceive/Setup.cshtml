@using BTCPayServer.Plugins.OpenReceive.Controllers
@model SetupViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(nameof(PluginNavPages.Setup), "OpenReceive"));
    var preflight = Model.Preflight;
}
<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="mb-0">OpenReceive</h2>
    <div class="d-flex gap-3 mt-3 mt-sm-0">
        <a asp-action="Doctor" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">Doctor</a>
    </div>
</div>
<partial name="_StatusMessage" />
<p class="text-muted">Receive Lightning payments straight into your own wallet with a <strong>receive-only</strong> NWC code, and optionally let payers pay with USDT, USDC, ETH or SOL through a Lightning Swap Connect provider — swaps settle into the same wallet. This store's internal node is never used.</p>

<form method="post" asp-action="Setup" asp-route-storeId="@Model.StoreId" autocomplete="off">
    <div class="row">
        <div class="col-xl-8 col-xxl-constrain">
            <h3 class="mt-3">1. Wallet</h3>
            <p class="text-muted small">Current Lightning node: <strong>@(Model.LightningNode ?? "none")</strong>@(Model.HasWallet ? " — an OpenReceive connection." : "")</p>
            <div class="form-group">
                <label asp-for="NwcUri" class="form-label">Receive-only NWC code</label>
                <textarea asp-for="NwcUri" class="form-control font-monospace" rows="3" placeholder="@(Model.SavedRedactedNwc ?? "nostr+walletconnect://…?relay=wss://…&secret=…")"></textarea>
                <span asp-validation-for="NwcUri" class="text-danger" style="white-space: pre-line"></span>
                <div class="form-text">
                    @if (Model.SavedRedactedNwc is not null) { <span>Saved: <code>@Model.SavedRedactedNwc</code>. Leave empty to keep it. </span> }
                    Get one: <a href="https://openreceive.org/get_a_nwc_code_to_receive_payments" target="_blank" rel="noreferrer noopener">openreceive.org/get_a_nwc_code_to_receive_payments</a>
                </div>
            </div>
            <div class="form-group form-check">
                <input asp-for="AllowSpendCapableWallet" type="checkbox" class="form-check-input" />
                <label asp-for="AllowSpendCapableWallet" class="form-check-label">This wallet cannot mint a receive-only code and I accept the risk</label>
                <div class="form-text">Default off. OpenReceive still never sends: BTCPay payouts and pull-payment refunds over Lightning stay unavailable with this backend.</div>
            </div>
            <div class="d-flex gap-2 mb-4">
                <button name="command" type="submit" value="test-wallet" class="btn btn-secondary">Test connection</button>
                <button name="command" type="submit" value="use-wallet" class="btn btn-primary">Use as this store's Lightning node</button>
            </div>

            @if (preflight is not null)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">@(preflight.Ok ? "✅ Wallet ready" : "❌ Wallet refused") <small class="text-muted">(@preflight.CheckedAt.ToString("u"))</small></h5>
                        @if (!preflight.Ok) { <p class="text-danger" style="white-space: pre-line">@preflight.Message</p> }
                        @if (preflight.Warning is not null) { <p class="text-warning" style="white-space: pre-line">@preflight.Warning</p> }
                        @if (preflight.Summary is { } s)
                        {
                            <dl class="row mb-0 small">
                                <dt class="col-sm-4">Wallet</dt><dd class="col-sm-8 text-break">@s.WalletPubkey</dd>
                                <dt class="col-sm-4">Relays</dt><dd class="col-sm-8">@string.Join(", ", s.Relays) @(preflight.RelayRoundTrip is { } rtt ? $"({rtt.TotalMilliseconds:0} ms)" : "")</dd>
                                <dt class="col-sm-4">Methods</dt><dd class="col-sm-8">@string.Join(", ", s.Methods)</dd>
                                <dt class="col-sm-4">Encryption</dt><dd class="col-sm-8">@(s.Encryption ?? "unsupported")</dd>
                                <dt class="col-sm-4">Notifications</dt><dd class="col-sm-8">@(s.Notifications.Count == 0 ? "none (settlement uses the periodic scan)" : string.Join(", ", s.Notifications))</dd>
                                <dt class="col-sm-4">Network</dt><dd class="col-sm-8">@(s.Network ?? "not reported")</dd>
                                <dt class="col-sm-4">Spend methods</dt><dd class="col-sm-8">@(s.SpendMethods.Count == 0 ? "none — the wallet reports no spend permissions for this connection" : string.Join(", ", s.SpendMethods))</dd>
                            </dl>
                        }
                    </div>
                </div>
            }
            else if (Model.LastPreflight is { } last)
            {
                <p class="small text-muted">Last test: @(last.Ok ? "ok" : $"refused ({last.Code})") at @last.CheckedAt.ToString("u").</p>
            }

            <h3 class="mt-4">2. Swaps <small class="text-muted fs-6">(optional)</small></h3>
            @if (!Model.HasWallet)
            {
                <div class="alert alert-info">Swaps settle into your OpenReceive wallet. Connect a receive-only NWC code first.</div>
            }
            <div class="form-group">
                <label asp-for="LscPrimary" class="form-label">Lightning Swap Connect code (primary)</label>
                <input asp-for="LscPrimary" class="form-control font-monospace" placeholder="lightning+swapconnect://provider.example/?key=…&secret=…" />
                <span asp-validation-for="LscPrimary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LscBackup" class="form-label">Backup LSC code <small class="text-muted">(used only while the primary is down)</small></label>
                <input asp-for="LscBackup" class="form-control font-monospace" />
                <span asp-validation-for="LscBackup" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mb-3">
                <button name="command" type="submit" value="test-provider" class="btn btn-secondary">Test provider</button>
            </div>
            @if (Model.ProviderTest is { } test)
            {
                <div class="card mb-3"><div class="card-body">
                    <h6>Provider @Model.ProviderTestName</h6>
                    <ul class="mb-0 small">
                        @foreach (var a in test)
                        {
                            <li>@a.Label — @(a.Available ? $"available (min {a.Minimum}, max {a.Maximum})" : $"unavailable: {a.Message}")</li>
                        }
                    </ul>
                </div></div>
            }
            <div class="form-group form-check">
                <input asp-for="SwapsEnabled" type="checkbox" class="form-check-input" />
                <label asp-for="SwapsEnabled" class="form-check-label">Offer swaps at checkout</label>
                <span asp-validation-for="SwapsEnabled" class="text-danger d-block"></span>
                <div class="form-text">Saving with swaps on sets this store's invoice expiration to 60 minutes (currently @Model.InvoiceExpirationMinutes) when it is shorter: a swap needs at least @Model.MinimumSwapInvoiceMinutes minutes of invoice life.</div>
            </div>
            <div class="form-group">
                <label class="form-label">Assets to offer</label>
                @foreach (var asset in Model.Assets)
                {
                    var selected = Model.EnabledPayInAssets?.Contains(asset.PayInAsset) == true;
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="EnabledPayInAssets" value="@asset.PayInAsset" id="asset-@asset.PayInAsset" checked="@selected" />
                        <label class="form-check-label" for="asset-@asset.PayInAsset">@asset.Label · @asset.NetworkLabel</label>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 mb-5">
                <button name="command" type="submit" value="save-swaps" class="btn btn-primary">Save swap settings</button>
            </div>
        </div>
    </div>
</form>
