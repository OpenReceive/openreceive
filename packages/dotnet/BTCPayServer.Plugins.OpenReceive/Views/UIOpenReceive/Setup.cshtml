@using BTCPayServer.Plugins.OpenReceive.Controllers
@model SetupViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(nameof(PluginNavPages.Setup), "OpenReceive"));
    var preflight = Model.Preflight;
}
<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="mb-0">OpenReceive</h2>
    <div class="d-flex gap-3 mt-3 mt-sm-0">
        <a asp-action="Doctor" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">Health check</a>
    </div>
</div>
<partial name="_StatusMessage" />
@if (!Model.HasWallet)
{
    <p class="text-muted">Receive Lightning payments straight into your own wallet with a <strong>receive-only</strong> NWC code, and optionally let payers pay with USDT, USDC, ETH or SOL through a Lightning Swap Connect provider — swaps settle into the same wallet. This store's internal node is never used.</p>
}

<form method="post" asp-action="Setup" asp-route-storeId="@Model.StoreId" autocomplete="off">
    <div class="row">
        <div class="col-xl-8 col-xxl-constrain">
            <h3 class="mt-3">1. Lightning Inbound Payments</h3>
            @if (Model.HasWallet)
            {
                @* Connected: one calm line; everything else lives behind the disclosure. *@
                <p class="mb-1">✅ <strong>Wallet connected.</strong> Invoices are minted in wallet <code>@Model.WalletShortId</code> via @Model.WalletRelayHosts@(Model.WalletLud16 is null ? "" : $" ({Model.WalletLud16})").@if (Model.AllowSpendCapableWallet) { <span class="text-warning"> Spend-capable override on.</span> }</p>
                @if (Model.LastPreflight is { } lastTest)
                {
                    <p class="small text-muted">Last test: @(lastTest.Ok ? "ok" : $"refused ({lastTest.Code})") at @lastTest.CheckedAt.ToString("u").</p>
                }
                <details class="mb-3" open="@Model.ChangeWalletOpen">
                    <summary class="text-muted" style="cursor:pointer">Change NWC receive code</summary>
                    <div class="form-group mt-3">
                        <label asp-for="NwcUri" class="form-label">New receive-only NWC code</label>
                        <textarea asp-for="NwcUri" class="form-control font-monospace" rows="3" placeholder="nostr+walletconnect://…?relay=wss://…&secret=…"></textarea>
                        <span asp-validation-for="NwcUri" class="text-danger" style="white-space: pre-line"></span>
                        <div class="form-text">The saved code is never shown again. Get one: <a href="https://openreceive.org/get_a_nwc_code_to_receive_payments" target="_blank" rel="noreferrer noopener">openreceive.org/get_a_nwc_code_to_receive_payments</a></div>
                    </div>
                    <partial name="_SpendOverride" model="Model" />
                    <div class="d-flex gap-2">
                        <button name="command" type="submit" value="use-wallet" class="btn btn-primary">Save NWC Code</button>
                    </div>
                </details>
                <div class="d-flex gap-2 mb-3">
                    <button name="command" type="submit" value="health-check" class="btn btn-primary">Run a health check</button>
                </div>
                @if (Model.HealthCheck is { } health)
                {
                    <div class="mb-4">
                        <partial name="_HealthProbes" model="health" />
                        @* The results live only in this response: OK is a plain reload of the page. *@
                        <a asp-action="Setup" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">OK</a>
                    </div>
                }
            }
            else
            {
                <div class="form-group">
                    <label asp-for="NwcUri" class="form-label">Receive-only NWC code</label>
                    <textarea asp-for="NwcUri" class="form-control font-monospace" rows="3" placeholder="nostr+walletconnect://…?relay=wss://…&secret=…"></textarea>
                    <span asp-validation-for="NwcUri" class="text-danger" style="white-space: pre-line"></span>
                    <div class="form-text">Get one: <a href="https://openreceive.org/get_a_nwc_code_to_receive_payments" target="_blank" rel="noreferrer noopener">openreceive.org/get_a_nwc_code_to_receive_payments</a></div>
                </div>
                <partial name="_SpendOverride" model="Model" />
                <div class="d-flex gap-2 mb-4">
                    <button name="command" type="submit" value="test-wallet" class="btn btn-secondary">Test connection</button>
                    <button name="command" type="submit" value="use-wallet" class="btn btn-primary">Save NWC Code</button>
                </div>
            }

            @if (preflight is not null)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">@(preflight.Ok ? "✅ Wallet ready" : "❌ Wallet refused") <small class="text-muted">(@preflight.CheckedAt.ToString("u"))</small></h5>
                        @if (!preflight.Ok) { <p class="text-danger" style="white-space: pre-line">@preflight.Message</p> }
                        @if (preflight.Warning is not null) { <p class="text-warning" style="white-space: pre-line">@preflight.Warning</p> }
                        @if (preflight.Summary is { } s)
                        {
                            <dl class="row mb-0 small">
                                <dt class="col-sm-4">Wallet</dt><dd class="col-sm-8 text-break">@s.WalletPubkey</dd>
                                <dt class="col-sm-4">Relays</dt><dd class="col-sm-8">@string.Join(", ", s.Relays) @(preflight.RelayRoundTrip is { } rtt ? $"({rtt.TotalMilliseconds:0} ms)" : "")</dd>
                                <dt class="col-sm-4">Methods</dt><dd class="col-sm-8">@string.Join(", ", s.Methods)</dd>
                                <dt class="col-sm-4">Encryption</dt><dd class="col-sm-8">@(s.Encryption ?? "unsupported")</dd>
                                <dt class="col-sm-4">Notifications</dt><dd class="col-sm-8">@(s.Notifications.Count == 0 ? "none (settlement uses the periodic scan)" : string.Join(", ", s.Notifications))</dd>
                                <dt class="col-sm-4">Network</dt><dd class="col-sm-8">@(s.Network ?? "not reported")</dd>
                                <dt class="col-sm-4">Spend methods</dt><dd class="col-sm-8">@(s.SpendMethods.Count == 0 ? "none — the wallet reports no spend permissions for this connection" : string.Join(", ", s.SpendMethods))</dd>
                            </dl>
                        }
                    </div>
                </div>
            }
            else if (!Model.HasWallet && Model.LastPreflight is { } last)
            {
                <p class="small text-muted">Last test: @(last.Ok ? "ok" : $"refused ({last.Code})") at @last.CheckedAt.ToString("u").</p>
            }

            @* Swaps settle into the OpenReceive wallet: the section only exists once one is connected. *@
            @if (Model.HasWallet)
            {
                <h3 class="mt-4">2. Swaps <small class="text-muted fs-6">(optional)</small></h3>
                @if (Model.SwapsConfigured)
                {
                    <p class="mb-1">✅ <strong>Swaps on.</strong> Provider @Model.SwapPrimaryHost@(Model.SwapBackupHost is null ? "" : $", backup {Model.SwapBackupHost}"). Payers can pay with every asset the provider supports.</p>
                    <details class="mb-5" open="@Model.ChangeSwapsOpen">
                        <summary class="text-muted" style="cursor:pointer">Change swap provider</summary>
                        <div class="mt-3">
                            <partial name="_SwapsForm" model="Model" />
                        </div>
                    </details>
                }
                else
                {
                    <partial name="_SwapsForm" model="Model" />
                }
            }
        </div>
    </div>
</form>
